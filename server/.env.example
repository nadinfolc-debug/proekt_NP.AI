# Bind (local test or RU VPS)
HOST=127.0.0.1
PORT=8788

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Admin cabinet (password never goes into the website JS)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now

# Optional VK community notify (NO personal data — only number + date/time)
# Community token with messages permission; peer ids of admins to notify
VK_ACCESS_TOKEN=
VK_NOTIFY_PEER_IDS=
VK_API_VERSION=5.199

# Rate limit for public form
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=600000
