# Bind. Local test: 127.0.0.1. Timeweb Cloud Apps: HOST=0.0.0.0 (PORT задаёт платформа).
HOST=127.0.0.1
PORT=8788

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://nadinfolc-debug.github.io

# Admin cabinet (password never goes into the website JS)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Persistent private volume OUTSIDE dist/public; only the server account may access it.
# DATA_DIR=/var/lib/npai

# Production App Platform: private Timeweb S3 in Russia. Never put keys in VITE_* or Git.
APPLICATION_STORAGE=file
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Letter to the operator when a form is saved (Yandex mailbox, sent from this server).
# Timeweb Cloud: create the app from the server/ folder, HOST=0.0.0.0, PORT is set by the platform.
# Yandex: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465, SMTP_USER is the full mailbox, SMTP_PASS is an app password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=np-ai-prikolota@yandex.com
SMTP_PASS=
SMTP_FROM=np-ai-prikolota@yandex.com
NOTIFY_EMAIL=np-ai-prikolota@yandex.com

# Optional VK community notify (NO personal data — only number + date/time)
# Community token with messages permission; peer ids of admins to notify
VK_ACCESS_TOKEN=
VK_NOTIFY_PEER_IDS=
VK_API_VERSION=5.199

# Rate limit for public form
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=600000
