# Public URL of the RU backend.
# Local: http://127.0.0.1:8788
# Timeweb Cloud Apps: https://your-app.twc1.net
# Never put ADMIN_PASSWORD, SMTP_PASS or VK_ACCESS_TOKEN into VITE_* variables.
# GitHub Pages, workers.dev, Cloudflare and Telegram API are blocked by check:152.
VITE_API_URL=http://127.0.0.1:8788

# Yandex Metrika counter id (digits only). Script loads only after «Принять все» in the cookie banner.
# VITE_YANDEX_METRIKA_ID=12345678
