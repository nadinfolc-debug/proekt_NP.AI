# Public URL of the RU backend (local test or your VPS in Russia).
# Never put ADMIN_PASSWORD or VK_ACCESS_TOKEN into VITE_* variables.
# Do NOT use workers.dev / Cloudflare / Telegram API URLs here (blocked by check:152).
VITE_API_URL=http://127.0.0.1:8788

# Yandex Metrika counter id (digits only). Script loads only after «Принять все» in the cookie banner.
# VITE_YANDEX_METRIKA_ID=12345678
